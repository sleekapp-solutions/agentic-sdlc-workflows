# Optional local overrides. Keep this file as a template only; `.env` is
# ignored by Git. The default uses an authenticated Codex CLI and its existing
# MCP connections, so it does not require a Jira API token or OpenAI API key.

# Local CLI provider: codex (default) or copilot. Both providers receive the
# Jira/PR content needed for the selected flow.
# WORKFLOW_AGENT_PROVIDER=codex

# Optional per-workflow Codex overrides. When omitted, the workflow uses the
# defaults resolved by the local Codex CLI configuration.
# WORKFLOW_CODEX_MODEL=gpt-5.6-terra
# WORKFLOW_CODEX_REASONING_EFFORT=medium

# Optional GitHub Copilot CLI model override. Copilot reasoning effort remains
# in COPILOT_HOME/settings.json because the CLI does not offer a scoped effort
# flag for programmatic runs.
# WORKFLOW_COPILOT_MODEL=gpt-5.3-codex
# WORKFLOW_COPILOT_TICKET_MCP_SERVER=atlassian

# Optional target repository for LangGraph Studio. CLI and local UI also accept
# an explicit --repo argument, which takes precedence for that invocation.
# WORKFLOW_REPO=/absolute/path/to/target-repository

# Semicolon-separated validation commands. When unset, commands are detected
# from the target repository (Flutter/Dart, Node, Go, Rust, Swift, Gradle,
# Maven, Python). Per-repository values belong in <repo>/.agentic-workflow.env.
# WORKFLOW_VALIDATION_COMMANDS=npm run lint; npm test

# Optional custom coding-agent command. It receives the approved delivery
# request as JSON on stdin and must not commit or push. When omitted, the
# selected provider supplies its supported default command.
# IMPLEMENTATION_COMMAND=codex exec --sandbox workspace-write -
