# Optional local overrides. Keep this file as a template only; `.env` is
# ignored by Git. The default uses an authenticated Codex CLI and its existing
# MCP connections, so it does not require a Jira API token or OpenAI API key.

# Optional per-workflow Codex overrides. When omitted, the workflow uses the
# defaults resolved by the local Codex CLI configuration.
# WORKFLOW_CODEX_MODEL=gpt-5.6-terra
# WORKFLOW_CODEX_REASONING_EFFORT=medium

# Optional target repository for LangGraph Studio. CLI and local UI also accept
# an explicit --repo argument, which takes precedence for that invocation.
# WORKFLOW_REPO=/absolute/path/to/target-repository

# Semicolon-separated validation commands. The default is Flutter validation.
# WORKFLOW_VALIDATION_COMMANDS=flutter analyze; flutter test

# A local coding-agent command. It receives the approved delivery request as
# JSON on stdin and must not commit or push. This is also the default.
IMPLEMENTATION_COMMAND=codex exec --sandbox workspace-write -
